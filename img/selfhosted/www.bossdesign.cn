        <script>
    (function(){
        var default_theme_mode = "light";
        var local_theme_mode = localStorage.getItem('theme');
        var current_theme_mode = (local_theme_mode === 'dark' || local_theme_mode === 'light') ? local_theme_mode : default_theme_mode;
        if (current_theme_mode === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.removeAttribute('data-theme');
        }
    })();

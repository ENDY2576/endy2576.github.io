<body class="home blog wp-theme-AeroCoreFree img-shadow">


<!-- 背景 banner（纯装饰层，经典模式不渲染） -->
<div class="site-banner" style="background-color: var(--header-bg-color, #1e2736); background-image: none;"></div>

<!-- 导航栏 -->
<header class="site-header site-header--banner site-header--bg-color" style="--header-bg-image: none;">
    <!-- 上层：Logo + 搜索框 + 深色模式 + 用户菜单 -->
    <div class="site-header__top">
        <div class="site-header__top-inner">
            <div class="site-header__left">
                <!-- Logo -->
                <a href="https://www.bossdesign.cn/" class="site-logo">
                                        <img class="site-logo-img site-logo-light" src="https://www.bossdesign.cn/wp-content/uploads/2026/04/Bossdesign-ico.png" alt="Boss设计">
                                        <img class="site-logo-img site-logo-dark" src="https://www.bossdesign.cn/wp-content/uploads/2026/04/Bossdesign-ico.png" alt="Boss设计">
                                                        </a>

